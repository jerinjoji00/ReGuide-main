# SMTP settings for Contact Support email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=joshwathomas05@gmail.com
SMTP_PASSWORD=your-app-password
SUPPORT_TO_EMAIL=joshwathomas05@gmail.com

# Optional: lock CORS to your frontend origin in development
# FRONTEND_ORIGIN=http://localhost:5173

# Razorpay credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Hosting platforms may provide this automatically.
PORT=5000

# Supabase backend credentials (service role key required for server inserts)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio SMS OTP (required for real phone verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Optional: Twilio Verify service SID. If set, OTPs use Twilio Verify instead of direct SMS.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
